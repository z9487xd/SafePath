{
  "configurations": [
    {
      "name": "ESP32",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:HOME}/.platformio/packages/framework-arduinoespressif32/**",
        "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32/**",
        "${workspaceFolder}/firmware/node/.pio/libdeps/esp32dev/**"
      ],
      "defines": [
        "ESP32",
        "ARDUINO=10800"
      ],
      "cStandard": "c11",
      "cppStandard": "c++14"
    }
  ],
  "version": 4
}
